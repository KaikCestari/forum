# Ollama local: deixe estas variáveis de fora. Nuvem: OLLAMA_URL=https://ollama.com e a chave de ollama.com/settings/keys
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
# Modelo fixo do assistente e modelo com visão que lê as imagens
LLAMA_MODEL=gpt-oss:20b
VISION_MODEL=gemma4:31b
# Em produção HTTPS atrás de proxy, exporte AQUAML_SECURE_COOKIES=true no ambiente do Java.
