# Ollama local: deixe OLLAMA_URL e OLLAMA_API_KEY de fora. Nuvem: OLLAMA_URL=https://ollama.com e a chave de ollama.com/settings/keys
OLLAMA_URL=https://ollama.com
OLLAMA_API_KEY=
# Modelo fixo do assistente e modelo com visão que lê as imagens
LLAMA_MODEL=gpt-oss:20b
VISION_MODEL=gemma4:31b
# Segredo do JWT (mínimo 32 caracteres). Sem ele, os logins caem a cada reinício.
JWT_SECRET=
# Administrador criado no primeiro início
ADMIN_EMAIL=admin@aquaml.local
ADMIN_PASSWORD=admin123
# Serviço de ML em Python
ML_SERVICE_URL=http://localhost:8000
